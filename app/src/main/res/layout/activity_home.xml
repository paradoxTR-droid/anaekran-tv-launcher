<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07080c">

    <!-- Sabit arka plan: hareketli hali boştayken her karede tam ekran çizim yapıp GPU'yu ~10 ms/kare meşgul ediyordu. -->
    <!-- Donanım katmanı: radyal geçiş bir kez dokuya çizilir; zayıf GPU'da (Mali-450) her karede yeniden hesaplanmaz. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_home"
        android:layerType="hardware" />

    <View
        android:id="@+id/glowA"
        android:layout_width="720dp"
        android:layout_height="720dp"
        android:layout_gravity="center"
        android:background="@drawable/glow_purple"
        android:visibility="gone" />

    <View
        android:id="@+id/glowB"
        android:layout_width="720dp"
        android:layout_height="720dp"
        android:layout_gravity="center"
        android:background="@drawable/glow_cyan"
        android:visibility="gone" />

    <View
        android:id="@+id/glowC"
        android:layout_width="720dp"
        android:layout_height="720dp"
        android:layout_gravity="center"
        android:background="@drawable/glow_pink"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="48dp"
            android:paddingTop="28dp"
            android:paddingEnd="48dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="#ffffff"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:textColor="#e6ffffff"
                android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical">

            <TextView android:id="@+id/labelFav" style="@style/RowLabel" android:text="@string/row_favorites" />

            <HorizontalScrollView
                android:id="@+id/favScroll"
                style="@style/RowScroll">

                <LinearLayout android:id="@+id/favRow" style="@style/RowInner" />
            </HorizontalScrollView>

            <TextView android:id="@+id/labelAll" style="@style/RowLabel" android:text="@string/row_all" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false">

                <HorizontalScrollView
                    android:id="@+id/allScroll"
                    style="@style/RowScroll">

                    <LinearLayout android:id="@+id/allRow" style="@style/RowInner" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="48dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/all_hidden"
                    android:textColor="#b3ffffff"
                    android:textSize="16sp"
                    android:visibility="gone" />
            
</FrameLayout>

            <TextView android:id="@+id/labelSettings" style="@style/RowLabel" android:text="@string/row_settings" />

            <LinearLayout
                android:id="@+id/tiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="48dp"
                android:paddingTop="8dp"
                android:paddingEnd="48dp"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/overlayTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="#ffffff"
        android:textSize="48sp"
        android:visibility="gone" />

    <View
        android:id="@+id/menuScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/menuPanel"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#ff121826"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="48dp"
        android:paddingEnd="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/menuTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="24dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="#ffffff"
            android:textSize="22sp" />

        <LinearLayout
            android:id="@+id/menuItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
