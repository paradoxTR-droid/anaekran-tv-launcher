<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="48dp"
            android:paddingTop="28dp"
            android:paddingEnd="48dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="#ffffff"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="sans-serif-light"
                android:textColor="#e6ffffff"
                android:textSize="22sp" />

            <ImageButton
                android:id="@+id/btnWifi"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/icon_bg"
                android:contentDescription="Wi-Fi"
                android:focusable="true"
                android:nextFocusDown="@id/grid"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wifi"
                android:tint="@color/icon_tint" />
            <ImageButton
                android:id="@+id/btnSound"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/icon_bg"
                android:contentDescription="Ses"
                android:focusable="true"
                android:nextFocusDown="@id/grid"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_sound"
                android:tint="@color/icon_tint" />
            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/icon_bg"
                android:contentDescription="Ayarlar"
                android:focusable="true"
                android:nextFocusDown="@id/grid"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings"
                android:tint="@color/icon_tint" />
        </LinearLayout>

        <GridView
            android:id="@+id/grid"
            android:nextFocusUp="@id/btnWifi"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:horizontalSpacing="24dp"
            android:listSelector="@android:color/transparent"
            android:numColumns="5"
            android:paddingStart="48dp"
            android:paddingTop="12dp"
            android:paddingEnd="48dp"
            android:paddingBottom="32dp"
            android:scrollbars="none"
            android:stretchMode="columnWidth"
            android:verticalSpacing="24dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/all_hidden"
        android:textColor="#b3ffffff"
        android:textSize="18sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/overlayTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="#ffffff"
        android:textSize="48sp"
        android:visibility="gone" />
</FrameLayout>
